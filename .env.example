# Copy to .env (never commit .env). All values are read on the server only.

# --- Gemini (optional) -------------------------------------------------------
# Server-side key for AI complaint suggestions. Leave empty to run without AI;
# students can still submit complaints manually.
GEMINI_API_KEY=
# Model id. Verify your key has access with: npm run check:gemini
GEMINI_MODEL=gemini-3.8-flash
# Abort a Gemini request after this many milliseconds (falls back to manual entry)
GEMINI_TIMEOUT_MS=15000

# --- First administrator -------------------------------------------------------
# Creates an admin account at startup only if no active admin exists.
# Password must be at least 12 characters. Remove these after first sign-in.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Storage ------------------------------------------------------------------
# Directory for the JSON data files (defaults to ./.data). Must be on persistent disk.
CAMPUSCONNECT_DATA_DIR=

# --- Notifications (emergency alerts and SLA escalations) ---------------------
# HTTPS endpoint of YOUR relay (e.g. a Twilio Function, n8n, or campus paging API).
# CampusConnect POSTs JSON { idempotencyKey, purpose, subjectId, recipient{id,name,phone,email,role},
# subject, body } with headers Idempotency-Key and X-CampusConnect-Signature
# (hex HMAC-SHA256 of the raw body using NOTIFY_WEBHOOK_SECRET). A 2xx reply = "accepted".
# Leave empty to record alerts without sending them (shown as "not configured").
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
# Secret your relay uses to sign delivery receipts sent to POST /api/notifications/receipt
# Body: { "notificationId" or "idempotencyKey", "status": "delivered" | "failed" }.
# Without it, the app can only show "accepted by provider", never "delivered".
NOTIFY_RECEIPT_SECRET=

# Public campus emergency number shown in the footer (leave empty if none is verified)
CAMPUS_EMERGENCY_CONTACT=

# How often the server-side scheduler runs (emergency escalation, SLA escalation, retries)
SCHEDULER_INTERVAL_MS=30000

# --- Demo mode ----------------------------------------------------------------
# "true" seeds sample tickets and demo accounts with PUBLISHED passwords on an empty
# data directory. Never enable for real users.
CAMPUSCONNECT_DEMO_SEED=false

# --- Server -------------------------------------------------------------------
PORT=3000
# NODE_ENV=production serves the built dist/ folder instead of the Vite dev server
NODE_ENV=
